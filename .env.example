# Copy this file to `.env` (same folder) and fill it in. `.env` is git-ignored.

# ── Pick a reader: set ONE of these two keys ───────────────────────────────
# Whichever you set is used. Set both and Gemini wins unless you say otherwise
# below. With neither, KevCal still runs but falls back to reading on this Mac,
# which is noticeably worse on real-world documents.

# Google AI Studio → "Get API key".  https://aistudio.google.com
# Best provenance: Gemini returns a box round the phrase it read, so the
# highlight-on-your-photo works even without the on-device OCR built.
GEMINI_API_KEY=

# OpenAI platform → API keys.  https://platform.openai.com
# Strongest guarantee on the shape of the answer: the API validates the schema
# itself. Weaker at bounding boxes, so provenance leans on the on-device OCR.
OPENAI_API_KEY=

# Force one when both keys are present: gemini | openai
# KEVCAL_READER=gemini

# Model overrides. Check current names in each provider's docs before pinning.
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-5.6-terra        # gpt-5.6-luna is the cheaper option

# ── Spend ceiling ──────────────────────────────────────────────────────────
# US dollars per month. KevCal prices every call from a built-in table and stops
# calling the reader once the NEXT call would take you over — then falls back to
# reading on this Mac, so imports keep working.
#
# Set here, it cannot be raised from the browser. Leave blank for no cap.
# This is the belt; the braces is a real cap at the provider (see README).
KEVCAL_MONTHLY_BUDGET=

# ── Required before you expose this beyond your own wifi ───────────────────
# This is the passcode. Anyone without it gets a passcode box and nothing else;
# typing it once remembers that device. Give it only to your group, and make it
# 12+ characters — four random words are easy to share and hard to guess.
# (The old …/?k=THE_TOKEN link still works too.)
KEVCAL_TOKEN=

# ── Who and what it is for ─────────────────────────────────────────────────
# Only school and work documents are kept: the reader labels each one, and
# anything else is refused and its upload deleted. On by default; 0 turns it off.
# KEVCAL_ONLY_SCHOOL_WORK=1

# Only let in visitors from these countries (ISO codes, comma-separated).
# Needs Cloudflare in front (the tunnel in DEPLOY.md) plus KEVCAL_TRUST_PROXY=1,
# because the country comes from Cloudflare's CF-IPCountry header. US covers
# the 50 states; Puerto Rico and other territories have their own codes.
# A VPN gets past this — it keeps out background bot noise, not a determined
# person. The passcode is still the lock. Shared lists and the calendar feed
# are left open, since calendar servers fetch them from anywhere.
# KEVCAL_ALLOW_COUNTRIES=US

# ── Behind a reverse proxy (see DEPLOY.md) ─────────────────────────────────
# Believe X-Forwarded-For and X-Forwarded-Proto. Needed so rate limiting counts
# real clients rather than the proxy, and so the auth cookie is marked Secure.
# Only turn this on together with KEVCAL_HOST=127.0.0.1 — trusting those headers
# while listening publicly lets anyone claim to be anyone.
# KEVCAL_TRUST_PROXY=1

# ── Rarely needed ──────────────────────────────────────────────────────────
# KEVCAL_PORT=4321
# KEVCAL_HOST=0.0.0.0
# KEVCAL_DATA=./data
