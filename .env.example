# Copy this file to `.env` (same folder) and fill it in. `.env` is git-ignored.

# ── Pick a reader: set ONE of these two keys ───────────────────────────────
# Whichever you set is used. Set both and Gemini wins unless you say otherwise
# below. With neither, KevCal still runs but falls back to reading on this Mac,
# which is noticeably worse on real-world documents.

# Google AI Studio → "Get API key".  https://aistudio.google.com
# Best provenance: Gemini returns a box round the phrase it read, so the
# highlight-on-your-photo works even without the on-device OCR built.
GEMINI_API_KEY=

# OpenAI platform → API keys.  https://platform.openai.com
# Strongest guarantee on the shape of the answer: the API validates the schema
# itself. Weaker at bounding boxes, so provenance leans on the on-device OCR.
OPENAI_API_KEY=

# Force one when both keys are present: gemini | openai
# KEVCAL_READER=gemini

# Model overrides. Check current names in each provider's docs before pinning.
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-5.6-terra        # gpt-5.6-luna is the cheaper option

# ── Required before you expose this beyond your own wifi ───────────────────
# Any long random string. Every request must then carry it, and the link you
# save to your home screen carries it for you (…/?k=THE_TOKEN).
# Make one with:  openssl rand -base64 24
KEVCAL_TOKEN=

# ── Rarely needed ──────────────────────────────────────────────────────────
# KEVCAL_PORT=4321
# KEVCAL_HOST=0.0.0.0
# KEVCAL_DATA=./data
